{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://newera.invalid/schema/project-state.schema.json",
  "title": "NewEra Project State",
  "description": "Machine-readable lifecycle, references and traceability index. Narrative remains in canonical Markdown documents.",
  "type": "object",
  "required": ["schemaVersion", "project", "documents", "milestones", "phases", "requirements", "tasks", "tests", "evidence", "risks", "changes", "traceability"],
  "properties": {
    "schemaVersion": {"const": 1},
    "project": {
      "type": "object",
      "required": ["id", "status", "governanceProfile", "roadmapPath"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]+$"},
        "status": {"enum": ["DRAFT", "READY", "IN_PROGRESS", "VERIFIED", "CHECKPOINT_PENDING", "ACCEPTED", "BLOCKED", "DEFERRED", "REJECTED", "CANCELLED"]},
        "governanceProfile": {"enum": ["LITE", "STANDARD", "STRICT"]},
        "roadmapPath": {"type": "string"}
      },
      "additionalProperties": false
    },
    "documents": {"type": "array", "items": {"$ref": "#/$defs/document"}},
    "milestones": {"type": "array", "items": {"$ref": "#/$defs/milestone"}},
    "phases": {"type": "array", "items": {"$ref": "#/$defs/phase"}},
    "requirements": {"type": "array", "items": {"$ref": "#/$defs/requirement"}},
    "tasks": {"type": "array", "items": {"$ref": "#/$defs/task"}},
    "tests": {"type": "array", "items": {"$ref": "#/$defs/test"}},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidenceRef"}},
    "risks": {"type": "array", "items": {"$ref": "#/$defs/risk"}},
    "changes": {"type": "array", "items": {"$ref": "#/$defs/change"}},
    "traceability": {"type": "array", "items": {"$ref": "#/$defs/edge"}},
    "acceptance": {
      "type": "object",
      "required": ["status"],
      "properties": {"status": {"enum": ["NOT_ACCEPTED", "ACCEPTED", "REJECTED", "DEFERRED"]}, "decisionRef": {"type": ["string", "null"]}},
      "additionalProperties": false
    }
  },
  "$defs": {
    "idList": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "document": {"type": "object", "required": ["id", "role", "path", "status"], "properties": {"id": {"type": "string"}, "role": {"type": "string"}, "path": {"type": "string"}, "status": {"type": "string"}}, "additionalProperties": false},
    "milestone": {"type": "object", "required": ["id", "status", "phaseIds"], "properties": {"id": {"type": "string"}, "status": {"type": "string"}, "phaseIds": {"$ref": "#/$defs/idList"}}, "additionalProperties": false},
    "phase": {"type": "object", "required": ["id", "milestoneId", "status", "requirementIds", "taskIds", "testIds", "evidenceIds"], "properties": {"id": {"type": "string"}, "milestoneId": {"type": "string"}, "status": {"type": "string"}, "requirementIds": {"$ref": "#/$defs/idList"}, "taskIds": {"$ref": "#/$defs/idList"}, "testIds": {"$ref": "#/$defs/idList"}, "evidenceIds": {"$ref": "#/$defs/idList"}}, "additionalProperties": false},
    "requirement": {"type": "object", "required": ["id", "status", "acceptanceCriteriaIds", "srsRef"], "properties": {"id": {"type": "string"}, "status": {"type": "string"}, "acceptanceCriteriaIds": {"$ref": "#/$defs/idList"}, "srsRef": {"type": "string"}, "architectureRefs": {"$ref": "#/$defs/idList"}}, "additionalProperties": false},
    "task": {"type": "object", "required": ["id", "status", "requirementIds", "testIds"], "properties": {"id": {"type": "string"}, "status": {"type": "string"}, "requirementIds": {"$ref": "#/$defs/idList"}, "testIds": {"$ref": "#/$defs/idList"}}, "additionalProperties": false},
    "test": {"type": "object", "required": ["id", "status", "type", "requirementIds", "taskIds", "evidenceIds"], "properties": {"id": {"type": "string"}, "status": {"type": "string"}, "type": {"enum": ["static", "unit", "integration", "e2e", "security", "product", "gate"]}, "requirementIds": {"$ref": "#/$defs/idList"}, "taskIds": {"$ref": "#/$defs/idList"}, "evidenceIds": {"$ref": "#/$defs/idList"}}, "additionalProperties": false},
    "risk": {"type": "object", "required": ["id", "status", "severity", "probability", "impact", "mitigation", "requirementIds"], "properties": {"id": {"type": "string"}, "status": {"type": "string"}, "severity": {"enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]}, "probability": {"enum": ["LOW", "MEDIUM", "HIGH"]}, "impact": {"enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]}, "mitigation": {"type": "string"}, "requirementIds": {"$ref": "#/$defs/idList"}, "taskIds": {"$ref": "#/$defs/idList"}}, "additionalProperties": false},
    "change": {"type": "object", "required": ["id", "status", "affectedIds", "decisionRef"], "properties": {"id": {"type": "string"}, "status": {"enum": ["PROPOSED", "ACCEPTED", "REJECTED", "DEFERRED"]}, "affectedIds": {"$ref": "#/$defs/idList"}, "decisionRef": {"type": "string"}}, "additionalProperties": false},
    "evidenceRef": {"type": "object", "required": ["id", "path", "status", "acceptanceStatus"], "properties": {"id": {"type": "string"}, "path": {"type": "string"}, "status": {"enum": ["VERIFIED", "PARTIAL", "FAILED", "BLOCKED", "NOT_RUN"]}, "acceptanceStatus": {"enum": ["NOT_ACCEPTED", "ACCEPTED", "REJECTED", "DEFERRED"]}}, "additionalProperties": false},
    "edge": {"type": "object", "required": ["source", "target", "type"], "properties": {"source": {"type": "string"}, "target": {"type": "string"}, "type": {"enum": ["specified-by", "architected-by", "planned-in", "implemented-by", "verified-by", "evidenced-by", "mitigates", "accepted-by"]}}, "additionalProperties": false}
  },
  "additionalProperties": false
}
