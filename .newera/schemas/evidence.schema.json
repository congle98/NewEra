{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://newera.invalid/schema/evidence.schema.json",
  "title": "NewEra Evidence Envelope",
  "description": "Machine-readable verification evidence. Human explanation remains in the linked Markdown evidence/report.",
  "type": "object",
  "required": ["schemaVersion", "id", "scope", "requirementRefs", "testRefs", "type", "command", "expected", "actual", "result", "commitRef", "timestamp", "environment", "acceptanceStatus", "limitations"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "pattern": "^EVD-[A-Z0-9_.-]+$"},
    "scope": {"type": "string", "minLength": 1},
    "requirementRefs": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "testRefs": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "type": {"enum": ["static", "unit", "integration", "e2e", "security", "product", "gate", "review"]},
    "command": {"type": "string", "minLength": 1},
    "expected": {"type": "string", "minLength": 1},
    "actual": {"type": "string", "minLength": 1},
    "result": {"enum": ["VERIFIED", "PARTIAL", "FAILED", "BLOCKED", "NOT_RUN"]},
    "commitRef": {"type": "string", "minLength": 1},
    "timestamp": {"type": "string", "format": "date-time"},
    "environment": {"type": "object", "required": ["os"], "properties": {"os": {"type": "string"}, "tools": {"type": "object"}}, "additionalProperties": true},
    "acceptanceStatus": {"enum": ["NOT_ACCEPTED", "ACCEPTED", "REJECTED", "DEFERRED"]},
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
