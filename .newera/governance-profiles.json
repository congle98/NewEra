{
  "schemaVersion": 1,
  "profiles": {
    "LITE": {
      "description": "Prototype/internal work with minimal ceremony.",
      "requiredDocumentRoles": ["roadmap", "task", "test", "evidence"],
      "requiredLinks": ["requirement-to-task", "task-to-test", "test-to-evidence"]
    },
    "STANDARD": {
      "description": "Default NewEra profile; preserves full traceability and acceptance separation.",
      "requiredDocumentRoles": ["roadmap", "srs", "architecture", "task", "test", "evidence", "acceptance"],
      "requiredLinks": ["requirement-to-srs", "requirement-to-task", "task-to-test", "test-to-evidence"]
    },
    "STRICT": {
      "description": "High-risk or regulated work; adds ADR, risk, security and operational gates.",
      "requiredDocumentRoles": ["roadmap", "srs", "architecture", "adr", "risk", "task", "test", "security", "evidence", "acceptance"],
      "requiredLinks": ["requirement-to-srs", "requirement-to-architecture", "requirement-to-risk", "risk-to-task", "task-to-test", "test-to-evidence"]
    }
  },
  "invariants": [
    "ROADMAP remains the source of truth for M/Phase/scope/order.",
